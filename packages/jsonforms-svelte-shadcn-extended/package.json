{
  "name": "@chobantonov/jsonforms-svelte-shadcn-extended",
  "version": "1.0.2",
  "description": "Extended Shadcn-styled JSONForms Svelte 5 renderers",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-shadcn-extended"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build && npm run prepack",
    "watch": "SHADCN_PRESERVE_UI_IMPORTS=true svelte-kit sync && SHADCN_PRESERVE_UI_IMPORTS=true svelte-package --watch",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "SHADCN_PRESERVE_UI_IMPORTS=true svelte-kit sync && SHADCN_PRESERVE_UI_IMPORTS=true svelte-package && publint --pack false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run --shard=1/2 && vp test --run --shard=2/2"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:^",
    "@chobantonov/jsonforms-svelte-extended": "workspace:^",
    "@chobantonov/jsonforms-svelte-shadcn": "workspace:^",
    "@jsonforms/core": "catalog:",
    "@lucide/svelte": "catalog:",
    "ag-grid-community": "catalog:",
    "ajv": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "lodash": "catalog:peers",
    "maska": "catalog:",
    "tailwind-merge": "catalog:peers",
    "tailwind-variants": "catalog:",
    "svelte": "catalog:peers",
    "@chobantonov/jsonforms-svelte-renderer-common": "workspace:^"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-shadcn": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@lucide/svelte": "catalog:",
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "ag-grid-community": "catalog:",
    "ajv": "catalog:",
    "dayjs": "catalog:",
    "playwright": "^1.58.1",
    "lodash": "^4.17.21",
    "maska": "catalog:",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:",
    "vite-plus": "catalog:",
    "@chobantonov/jsonforms-extended-spec": "catalog:",
    "@chobantonov/jsonforms-svelte-renderer-common": "workspace:*"
  }
}
