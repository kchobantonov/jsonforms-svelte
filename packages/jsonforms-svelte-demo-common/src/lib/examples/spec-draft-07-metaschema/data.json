{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Inventory item",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": "integer",
      "minimum": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["reference"],
  "additionalProperties": false
}
