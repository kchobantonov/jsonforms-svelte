{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Control",
      "scope": "#/properties/jobName"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Schema selection",
          "i18n": "featureNavigation.section1",
          "elements": [
            {
              "type": "Group",
              "label": "Selected by the schema",
              "i18n": "group.selectedBySchema",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/selectedBySchema/properties/stockSync"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/selectedBySchema/properties/supplierFeed"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/selectedBySchema/properties/monthEndReport"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "UI schema selection",
          "i18n": "featureNavigation.section2",
          "elements": [
            {
              "type": "Group",
              "label": "Selected by the UI schema",
              "i18n": "group.selectedByUiSchema",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/selectedByUiSchema/properties/cacheWarm",
                  "options": {
                    "format": "cron"
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/selectedByUiSchema/properties/unset",
                  "options": {
                    "format": "cron",
                    "placeholder": "0 0 3 * * *"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Unsupported dialect",
          "i18n": "featureNavigation.section3",
          "elements": [
            {
              "type": "Group",
              "label": "Not this dialect",
              "i18n": "group.rejected",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/rejected/properties/unixFiveField"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/rejected/properties/quartzSevenField"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
