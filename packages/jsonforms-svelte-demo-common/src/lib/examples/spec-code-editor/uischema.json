{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Label",
      "i18n": "intro"
    },
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Script",
          "i18n": "featureNavigation.section1",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/script",
              "options": {
                "format": "code",
                "language": "javascript",
                "monaco": {
                  "autoGrow": true,
                  "minRows": 2,
                  "maxRows": 10,
                  "initActions": ["editor.action.formatDocument"]
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Markup",
          "i18n": "featureNavigation.section2",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/markup",
              "options": {
                "format": "code",
                "language": "html",
                "monaco": {
                  "rows": 10,
                  "initActions": ["editor.action.formatDocument"]
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Structured document",
          "i18n": "featureNavigation.section3",
          "elements": [
            {
              "type": "Control",
              "scope": "#/properties/document",
              "options": {
                "format": "code",
                "language": "json",
                "convertJson": true,
                "monaco": {
                  "rows": 8
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
