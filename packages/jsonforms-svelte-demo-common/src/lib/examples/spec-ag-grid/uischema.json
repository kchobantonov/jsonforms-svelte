{
  "type": "Categorization",
  "elements": [
    {
      "type": "Category",
      "label": "Normal table",
      "elements": [
        {
          "type": "Label",
          "text": "Portable options.pagination shows three applicants per page. Contact has its own cell dialog; Edit details opens the whole applicant, including notes."
        },
        {
          "type": "Control",
          "scope": "#/properties/applicants",
          "options": {
            "columnDefs": [
              {
                "field": "name",
                "width": 180
              },
              {
                "field": "email",
                "minWidth": 220,
                "maxWidth": 360
              },
              {
                "field": "experience",
                "width": 160
              },
              {
                "field": "contact",
                "width": 180
              }
            ],
            "cells": {
              "contact": {
                "summary": {
                  "type": "Control",
                  "scope": "#/properties/city"
                },
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/city"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/phone"
                    }
                  ]
                }
              }
            },
            "rowDetail": {
              "presentation": "dialog",
              "detail": {
                "type": "VerticalLayout",
                "elements": [
                  {
                    "type": "Control",
                    "scope": "#/properties/name"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/email"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/experience"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/contact"
                  },
                  {
                    "type": "Control",
                    "scope": "#/properties/notes"
                  }
                ]
              }
            },
            "table": true,
            "pagination": {
              "pageSize": 3,
              "pageSizeOptions": [3, 6, 12]
            }
          }
        }
      ]
    },
    {
      "type": "Category",
      "label": "AG Grid: portable",
      "elements": [
        {
          "type": "Label",
          "text": "Portable options.columnDefs and options.pagination specify the same columns and three rows per page as the normal table; no agGridOptions are needed. Only the renderer selection changes. Sort or filter, then open Edit details to inspect the original applicant."
        },
        {
          "type": "Control",
          "scope": "#/properties/applicants",
          "options": {
            "columnDefs": [
