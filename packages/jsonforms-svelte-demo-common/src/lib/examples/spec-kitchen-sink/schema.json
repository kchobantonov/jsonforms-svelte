{
  "type": "object",
  "required": [
    "firstName",
    "lastName",
    "email",
    "phone",
    "password",
    "otp",
    "position",
    "termsAccepted"
  ],
  "properties": {
    "firstName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "title": "First name"
    },
    "lastName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "title": "Last name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 254,
      "title": "Email"
    },
    "phone": {
      "type": "string",
      "pattern": "^\\+[1-9][0-9]{7,14}$",
      "title": "International phone"
    },
    "website": {
      "type": "string",
      "format": "uri",
      "title": "Website"
    },
    "password": {
      "type": "string",
      "format": "password",
      "minLength": 12,
      "title": "Password"
    },
    "otp": {
      "type": "string",
      "format": "password",
      "minLength": 6,
      "maxLength": 6,
      "pattern": "^[0-9]+$",
      "title": "Verification code"
    },
    "bio": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "title": "Biography"
    },
    "address": {
      "type": "object",
      "required": ["city", "street", "postalCode"],
      "properties": {
        "city": {
          "type": "string",
          "minLength": 1,
          "title": "City"
        },
        "street": {
          "type": "string",
          "minLength": 1,
          "title": "Street"
        },
        "postalCode": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,11}$",
          "title": "Postal code"
        }
      },
      "title": "Postal address"
    },
    "preferredContact": {
      "type": "object",
      "oneOf": [
        {
          "title": "Email",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "title": "Email"
            }
          },
          "required": ["email"],
          "additionalProperties": false,
          "type": "object"
        },
        {
          "title": "Phone",
          "properties": {
            "phone": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{7,14}$",
              "title": "Phone"
            }
          },
          "required": ["phone"],
          "additionalProperties": false,
          "type": "object"
        }
      ],
      "title": "Preferred contact"
    },
    "availableContacts": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254,
          "title": "Email"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9][0-9]{7,14}$",
          "title": "Phone"
        }
      },
      "anyOf": [
        {
          "title": "Email",
          "required": ["email"],
          "type": "object",
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "title": "Email"
            }
          }
        },
        {
          "title": "Phone",
          "required": ["phone"],
          "type": "object",
          "properties": {
            "phone": {
              "type": "string",
              "pattern": "^\\+[1-9][0-9]{7,14}$",
              "title": "Phone"
            }
          }
        }
      ],
      "title": "Available contacts"
    },
    "billing": {
      "type": "object",
      "allOf": [
        {
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "title": "Name"
            }
          },
          "required": ["name"],
          "type": "object"
        },
        {
          "properties": {
            "email": {
              "type": "string",
              "format": "email",
              "maxLength": 254,
              "title": "Email"
            }
          },
          "required": ["email"],
          "type": "object"
        }
      ],
      "title": "Billing contact"
    },
    "department": {
      "type": "string",
      "enum": ["engineering", "research", "operations"],
      "title": "Department"
    },
    "workMode": {
      "type": "string",
      "enum": ["office", "remote", "hybrid"],
      "title": "Work mode"
    },
    "newsletter": {
      "type": "boolean",
      "title": "Job alerts"
    },
    "active": {
      "type": "boolean",
      "title": "Open to relocation"
    },
    "age": {
      "type": "integer",
      "minimum": 18,
      "maximum": 120,
      "title": "Age"
    },
    "budget": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000,
      "multipleOf": 0.01,
      "title": "Expected annual salary"
    },
    "allocation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "title": "Desired workload (%)"
    },
    "color": {
      "type": "string",
      "format": "color",
      "title": "Accent color"
    },
    "startDate": {
      "type": "string",
      "format": "date",
      "title": "Start date"
    },
    "startTime": {
      "type": "string",
      "format": "time",
      "title": "Start time"
    },
    "appointment": {
      "type": "string",
      "format": "date-time",
      "title": "Appointment"
    },
    "duration": {
      "type": "string",
      "format": "duration",
      "title": "Contract duration"
    },
    "cron": {
      "type": "string",
      "format": "cron",
      "title": "Reminder schedule"
    },
    "team": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "email", "phone"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone"
          },
          "address": {
            "type": "object",
            "required": ["city", "street", "postalCode"],
            "properties": {
              "city": {
                "type": "string",
                "minLength": 1,
                "title": "City"
              },
              "street": {
                "type": "string",
                "minLength": 1,
                "title": "Street"
              },
              "postalCode": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,11}$",
                "title": "Postal code"
              }
            },
            "title": "Address"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "title": "Skills"
          }
        }
      },
      "title": "References"
    },
    "gridTeam": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "email", "phone"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "title": "Email"
          },
          "phone": {
            "type": "string",
            "pattern": "^\\+[1-9][0-9]{7,14}$",
            "title": "Phone"
          },
          "address": {
            "type": "object",
            "required": ["city", "street", "postalCode"],
            "properties": {
              "city": {
                "type": "string",
                "minLength": 1,
                "title": "City"
              },
              "street": {
                "type": "string",
                "minLength": 1,
                "title": "Street"
              },
              "postalCode": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9 -]{1,11}$",
                "title": "Postal code"
              }
            },
            "title": "Address"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "title": "Skills"
          }
        }
      },
      "title": "References"
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["company", "years"],
        "properties": {
          "company": {
            "type": "string",
            "minLength": 1,
            "title": "Company"
          },
          "years": {
            "type": "integer",
            "minimum": 0,
            "maximum": 60,
            "title": "Years"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "title": "Email"
          }
        }
      },
      "title": "Work experience"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "title": "Skills"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "maxLength": 80
      },
      "title": "Additional properties"
    },
    "tuple": {
      "type": "array",
      "items": [
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2,
      "title": "Location tuple"
    },
    "payload": {
      "type": ["object", "array", "string", "number", "boolean", "null"],
      "title": "Integration metadata"
    },
    "attachment": {
      "type": "string",
      "title": "Résumé (PDF)",
      "format": "binary",
      "contentMediaType": "application/pdf",
      "contentEncoding": "base64"
    },
    "policy": {
      "type": "string",
      "minLength": 2,
      "title": "Work sample (JSON)"
    },
    "position": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100
    },
    "termsAccepted": {
      "type": "boolean",
      "const": true
    }
  }
}
