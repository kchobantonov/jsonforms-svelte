{
  "type": "VerticalLayout",
  "elements": [
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Positional editors",
          "i18n": "featureNavigation.section1",
          "elements": [
            {
              "type": "Label",
              "text": "Positional arrays. Each position is its own editor; the array is one value."
            },
            {
              "type": "Control",
              "scope": "#/properties/coordinates",
              "options": {
                "showBorder": false
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/dimensions",
              "options": {
                "variant": "tuple",
                "vertical": true
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/survey",
              "options": {
                "detail": {
                  "type": "VerticalLayout",
                  "elements": [
                    {
                      "type": "Group",
                      "label": "Ground position",
                      "elements": [
                        {
                          "type": "HorizontalLayout",
                          "elements": [
                            {
                              "type": "Control",
                              "scope": "#/items/1"
                            },
                            {
                              "type": "Control",
                              "scope": "#/items/0"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "Control",
                      "scope": "#/items/2"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "Category",
          "label": "Missing and trailing values",
          "i18n": "featureNavigation.section2",
          "elements": [
            {
              "type": "Label",
              "text": "Missing positions, and trailing values"
            },
            {
              "type": "Control",
              "scope": "#/properties/orderLine"
            },
            {
              "type": "Control",
              "scope": "#/properties/inspection"
            },
            {
              "type": "Control",
              "scope": "#/properties/flexible"
            }
          ]
        },
        {
          "type": "Category",
          "label": "Complex and invalid values",
          "i18n": "featureNavigation.section3",
          "elements": [
            {
              "type": "Label",
              "text": "Complex positions, and values that do not fit"
            },
            {
              "type": "Control",
              "scope": "#/properties/projectContact",
              "options": {
                "showEmptyButton": true,
                "okLabel": "tuple.save",
                "cancelLabel": "tuple.discard"
              }
            },
            {
              "type": "Control",
              "scope": "#/properties/handoffContacts"
            },
            {
              "type": "Control",
              "scope": "#/properties/legacyAssignment"
            },
            {
              "type": "Control",
              "scope": "#/properties/misconfigured",
              "options": {
                "variant": "tuple"
              }
            }
          ]
        }
      ]
    }
  ]
}
