{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Appointment options",
  "required": ["processing", "requiredCardDecision"],
  "properties": {
    "processing": {
      "type": "string",
      "title": "Processing speed",
      "enum": ["Standard", "Express", "Overnight"],
      "description": "A plain enum, laid out in a row."
    },
    "workspace": {
      "type": "string",
      "title": "Workspace",
      "enum": ["Private office", "Shared desk", "Meeting room", "Studio", "Open workspace"],
      "description": "The same control stacked, for longer labels."
    },
    "department": {
      "type": "string",
      "title": "Billing department",
      "oneOf": [
        {
          "const": "eng",
          "title": "Engineering"
        },
        {
          "const": "fin",
          "title": "Finance"
        }
      ],
      "description": "Labels come from branch titles; the stored value stays the constant."
    },
    "priority": {
      "type": "integer",
      "title": "Priority",
      "enum": [1, 2, 3],
      "description": "Numeric choices keep their JSON type; 1 is never stored as \"1\"."
    },
    "region": {
      "type": "string",
      "title": "Region",
      "enum": ["London", "Manchester"],
      "description": "Unselected on purpose: mounting must not choose the first option."
    },
    "supplier": {
      "type": "string",
      "title": "Supplier",
      "enum": ["Internal", "External"],
      "description": "Holds a value outside the permitted set, preserved for correction."
    },
    "origin": {
      "type": "string",
      "title": "Office location",
      "enum": ["Portland", "Salem", "Seattle", "Spokane", "Sacramento", "San Jose"],
      "description": "Long enough to be worth searching; autocomplete is opt-in here."
    },
    "handler": {
      "type": "string",
      "title": "Handling team",
      "oneOf": [
        {
          "const": "eng",
          "title": "Engineering"
        },
        {
          "const": "fin",
          "title": "Finance"
        },
        {
          "const": "ops",
          "title": "Operations"
        }
      ],
      "description": "Searching matches the visible label, not the stored constant."
    },
    "cardDecision": {
      "type": "string",
      "title": "Decision",
      "enum": ["approve", "decline"]
    },
    "cardLevel": {
      "title": "Typed choices",
      "oneOf": [
        {
          "const": false,
          "title": "Off"
        },
        {
          "const": 1,
          "title": "One"
        },
        {
          "const": 2,
          "title": "Two"
        }
      ]
    },
    "cardContact": {
      "title": "Contact method",
      "type": "object",
      "oneOf": [
        {
          "title": "Email",
          "properties": {
            "kind": {
              "const": "email",
              "default": "email"
            },
            "address": {
              "type": "string",
              "title": "Email address",
              "format": "email"
            }
          },
          "required": ["kind", "address"]
        },
        {
          "title": "Postal mail",
          "properties": {
            "kind": {
              "const": "postal",
              "default": "postal"
            },
            "street": {
              "type": "string",
              "title": "Street"
            },
            "city": {
              "type": "string",
              "title": "City"
            }
          },
          "required": ["kind", "street", "city"]
        }
      ]
    },
    "cardAutomatic": {
      "title": "Automatic cards",
      "enum": ["Small", "Medium", "Large"]
    },
    "requiredCardDecision": {
      "type": "string",
      "title": "Required decision",
      "enum": ["approve", "decline"]
    },
    "invalidCardDecision": {
      "type": "string",
      "title": "Invalid imported decision",
      "enum": ["approve", "decline"]
    },
    "invalidCardContact": {
      "title": "Contact with invalid details",
      "type": "object",
      "oneOf": [
        {
          "title": "Email",
          "properties": {
            "kind": {
              "const": "email",
              "default": "email"
            },
            "address": {
              "type": "string",
              "title": "Email address",
              "format": "email"
            }
          },
          "required": ["kind", "address"]
        },
        {
          "title": "Postal mail",
          "properties": {
            "kind": {
              "const": "postal",
              "default": "postal"
            },
            "street": {
              "type": "string",
              "title": "Street"
            },
            "city": {
              "type": "string",
              "title": "City"
            }
          },
          "required": ["kind", "street", "city"]
        }
      ]
    },
    "objectDropdown": {
      "title": "Object dropdown",
      "oneOf": [
        {
          "const": {
            "mode": "email",
            "settings": {
              "priority": 1
            }
          },
          "title": "Email",
          "i18n": "compositeChoices.option0"
        },
        {
          "const": {
            "mode": "postal",
            "settings": {
              "priority": 2
            }
          },
          "title": "Postal mail",
          "i18n": "compositeChoices.option1"
        }
      ]
    },
    "objectRadio": {
      "title": "Object radio choices",
      "oneOf": [
        {
          "const": {
            "mode": "email",
            "settings": {
              "priority": 1
            }
          },
          "title": "Email",
          "i18n": "compositeChoices.option0"
        },
        {
          "const": {
            "mode": "postal",
            "settings": {
              "priority": 2
            }
          },
          "title": "Postal mail",
          "i18n": "compositeChoices.option1"
        }
      ]
    },
    "arrayDropdown": {
      "title": "Array dropdown",
      "oneOf": [
        {
          "const": [
            "email",
            {
              "priority": 1
            }
          ],
          "title": "Email route",
          "i18n": "compositeChoices.option0"
        },
        {
          "const": [
            "postal",
            {
              "priority": 2
            }
          ],
          "title": "Postal route",
          "i18n": "compositeChoices.option1"
        }
      ]
    },
    "arrayRadio": {
      "title": "Array radio choices",
      "oneOf": [
        {
          "const": [
            "email",
            {
              "priority": 1
            }
          ],
          "title": "Email route",
          "i18n": "compositeChoices.option0"
        },
        {
          "const": [
            "postal",
            {
              "priority": 2
            }
          ],
          "title": "Postal route",
          "i18n": "compositeChoices.option1"
        }
      ]
    },
    "compositeRows": {
      "type": "array",
      "title": "Composite choices in cells",
      "items": {
        "type": "object",
        "properties": {
          "objectChoice": {
            "oneOf": [
              {
                "const": {
                  "mode": "email",
                  "settings": {
                    "priority": 1
                  }
                },
                "title": "Email",
                "i18n": "compositeChoices.option0"
              },
              {
                "const": {
                  "mode": "postal",
                  "settings": {
                    "priority": 2
                  }
                },
                "title": "Postal mail",
                "i18n": "compositeChoices.option1"
              }
            ]
          },
          "arrayChoice": {
            "oneOf": [
              {
                "const": [
                  "email",
                  {
                    "priority": 1
                  }
                ],
                "title": "Email route",
                "i18n": "compositeChoices.option0"
              },
              {
                "const": [
                  "postal",
                  {
                    "priority": 2
                  }
                ],
                "title": "Postal route",
                "i18n": "compositeChoices.option1"
              }
            ]
          }
        }
      }
    }
  }
}
