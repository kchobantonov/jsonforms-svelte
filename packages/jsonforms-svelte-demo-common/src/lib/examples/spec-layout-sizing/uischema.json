{
  "type": "VerticalLayout",
  "options": {
    "gap": "1.5rem"
  },
  "elements": [
    {
      "type": "Categorization",
      "elements": [
        {
          "type": "Category",
          "label": "Span",
          "i18n": "featureNavigation.section1",
          "elements": [
            {
              "type": "Label",
              "text": "Span: shares of a 16-column grid"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/reference",
                  "options": {
                    "layout": {
                      "span": 4
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/supplier",
                  "options": {
                    "layout": {
                      "span": 8
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/weightKg",
                  "options": {
                    "layout": {
                      "span": 4
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Weight",
          "i18n": "featureNavigation.section2",
          "elements": [
            {
              "type": "Label",
              "text": "Weight: shares of what is left over"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/origin",
                  "options": {
                    "layout": {
                      "weight": 2
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/destination",
                  "options": {
                    "layout": {
                      "weight": 2
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/priority",
                  "options": {
                    "layout": {
                      "weight": 1
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Sizing precedence",
          "i18n": "featureNavigation.section3",
          "elements": [
            {
              "type": "Label",
              "text": "Fixed beats span beats weight; min and max constrain"
            },
            {
              "type": "HorizontalLayout",
              "options": {
                "align": "start",
                "minItemWidth": 120
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/priority",
                  "options": {
                    "layout": {
                      "width": 180
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/notes",
                  "options": {
                    "layout": {
                      "weight": 1,
                      "maxWidth": "32rem"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Hidden children",
          "i18n": "featureNavigation.section4",
          "elements": [
            {
              "type": "Label",
              "text": "A hidden child leaves layout entirely"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/needsApproval"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/approvalCode",
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/needsApproval",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Spacer",
          "i18n": "featureNavigation.section5",
          "elements": [
            {
              "type": "Label",
              "text": "Spacer takes the parent's main axis"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/origin",
                  "options": {
                    "layout": {
                      "span": 5
                    }
                  }
                },
                {
                  "type": "Spacer",
                  "size": 48
                },
                {
                  "type": "Control",
                  "scope": "#/properties/destination",
                  "options": {
                    "layout": {
                      "span": 5
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Wrapping",
          "i18n": "featureNavigation.section6",
          "elements": [
            {
              "type": "Label",
              "text": "Wrap, with a minimum item width"
            },
            {
              "type": "HorizontalLayout",
              "options": {
                "wrap": true,
                "minItemWidth": "14rem",
                "justify": "space-between"
              },
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/reference"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/supplier"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/origin"
                },
                {
                  "type": "Control",
                  "scope": "#/properties/destination"
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Conditional columns",
          "i18n": "featureNavigation.section7",
          "elements": [
            {
              "type": "Label",
              "text": "4 / 8 / 4, and a toggle that removes the middle one"
            },
            {
              "type": "Control",
              "scope": "#/properties/showTeam"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/bookedBy",
                  "options": {
                    "layout": {
                      "span": 4
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/teamName",
                  "options": {
                    "layout": {
                      "span": 8
                    }
                  },
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/showTeam",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/approvedBy",
                  "options": {
                    "layout": {
                      "span": 4
                    }
                  }
                }
              ]
            },
            {
              "type": "Label",
              "text": "The same three, by weight instead of span"
            },
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Control",
                  "scope": "#/properties/bookedBy",
                  "options": {
                    "layout": {
                      "weight": 1
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/teamName",
                  "options": {
                    "layout": {
                      "weight": 2
                    }
                  },
                  "rule": {
                    "effect": "SHOW",
                    "condition": {
                      "scope": "#/properties/showTeam",
                      "schema": {
                        "const": true
                      }
                    }
                  }
                },
                {
                  "type": "Control",
                  "scope": "#/properties/approvedBy",
                  "options": {
                    "layout": {
                      "weight": 1
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Fixed and automatic widths",
          "i18n": "featureNavigation.section8",
          "elements": [
            {
              "type": "Group",
              "label": "One quarter, unused space",
              "i18n": "quarterOnly",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference",
                      "options": {
                        "layout": {
                          "span": 4
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Fixed plus Auto",
              "i18n": "quarterAuto",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference",
                      "options": {
                        "layout": {
                          "span": 4
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/supplier"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Fixed plus two Auto",
              "i18n": "quarterTwoAuto",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference",
                      "options": {
                        "layout": {
                          "span": 4
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/supplier"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/notes"
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Fixed widths leave unused space",
              "i18n": "unusedHalf",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference",
                      "options": {
                        "layout": {
                          "span": 4
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/supplier",
                      "options": {
                        "layout": {
                          "span": 4
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "type": "Group",
              "label": "Overflow wraps in order",
              "i18n": "overflow",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference",
                      "options": {
                        "layout": {
                          "span": 12
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/supplier",
                      "options": {
                        "layout": {
                          "span": 8
                        }
                      }
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/notes"
                    }
                  ],
                  "options": {
                    "wrap": true
                  }
                }
              ]
            },
            {
              "type": "Group",
              "label": "All Auto, equal thirds",
              "i18n": "equalThirds",
              "elements": [
                {
                  "type": "HorizontalLayout",
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/reference"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/supplier"
                    },
                    {
                      "type": "Control",
                      "scope": "#/properties/notes"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Category",
          "label": "Nested presentation",
          "i18n": "nestedSizing.tab",
          "elements": [
            {
              "type": "HorizontalLayout",
              "elements": [
                {
                  "type": "Label",
                  "text": "Quarter-width label",
                  "i18n": "nestedSizing.label",
                  "options": {
                    "layout": {
                      "span": 4
                    }
                  }
                },
                {
                  "type": "Group",
                  "label": "Nested group",
                  "i18n": "nestedSizing.group",
                  "options": {
                    "layout": {
                      "span": 8
                    }
                  },
                  "elements": [
                    {
                      "type": "Control",
                      "scope": "#/properties/notes"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
