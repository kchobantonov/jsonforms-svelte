{
  "name": "@chobantonov/jsonforms-svelte-demo-common",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Svelte demo utilities for JSONForms demo apps",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-demo-common"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build && npm run prepack",
    "watch": "svelte-kit sync && svelte-package --watch",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint --pack false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@sveltejs/kit": "catalog:peers",
    "svelte": "catalog:peers"
  },
  "dependencies": {
    "@jsonforms/core": "catalog:",
    "@jsonforms/examples": "catalog:",
    "ajv": "catalog:",
    "ajv-keywords": "catalog:",
    "dayjs": "catalog:",
    "lodash": "^4.17.21",
    "monaco-editor": "catalog:",
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-extended-spec": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "^1.58.1",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:",
    "vite-plus": "catalog:"
  }
}
