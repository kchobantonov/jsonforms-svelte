{
  "name": "@chobantonov/jsonforms-svelte-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "pnpm check && svelte-package --tsconfig tsconfig.package.json -i src/lib -o dist",
    "test": "svelte-package --tsconfig tsconfig.package.json -i src/lib -o dist && node --experimental-strip-types --test tests/*.test.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./styles.css": "./dist/editor/styles/editor.css"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@jsonforms/core": "catalog:",
    "clsx": "^2.1.1",
    "monaco-editor": "0.55.1",
    "svelte-dnd-action": "^0.9.79",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "paneforge": "^1.0.2",
    "@lucide/svelte": "^0.542.0",
    "bits-ui": "^2.16.3",
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-shadcn": "workspace:*",
    "shadcn-svelte": "^1.4.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "4.2.1",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "4.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "@sveltejs/package": "^2.5.7"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "svelte": "^5.0.0"
  }
}
