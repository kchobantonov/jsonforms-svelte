{
  "name": "@chobantonov/jsonforms-svelte-flowbite",
  "version": "1.0.2",
  "description": "Flowbite-styled JSONForms Svelte 5 components",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-flowbite"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build && npm run prepack",
    "watch": "svelte-kit sync && svelte-package --watch",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint --pack false",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@jsonforms/core": "catalog:",
    "ajv": "^8.20.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.10.6",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.31.0",
    "flowbite-svelte-icons": "^3.1.0",
    "lodash": "^4.17.21",
    "maska": "^3.2.0",
    "svelte": "^5.40.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "^4.14.172",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ajv": "^8.20.0",
    "dayjs": "^1.10.6",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.3.0",
    "lodash": "^4.17.21",
    "maska": "^3.2.0",
    "playwright": "^1.58.1",
    "publint": "^0.3.17",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:",
    "vite-plus": "catalog:"
  }
}
