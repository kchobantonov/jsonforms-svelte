{
  "name": "@chobantonov/jsonforms-svelte-shadcn-webcomponent",
  "version": "2.0.0",
  "description": "Shadcn-based JSONForms Svelte Web Component",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-shadcn-webcomponent"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build",
    "preview": "vp preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run"
  },
  "files": [
    "dist",
    "src/lib/components/ui/stepper/LICENSE",
    "src/lib/components/ui/tags-input/LICENSE",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "types"
  ],
  "types": "./types/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/jsonforms-svelte-shadcn.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-shadcn": "workspace:*",
    "@chobantonov/jsonforms-svelte-shadcn-extended": "workspace:*",
    "@internationalized/date": "catalog:",
    "@jsonforms/core": "catalog:",
    "@lucide/svelte": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ag-grid-community": "catalog:",
    "ajv": "catalog:",
    "ajv-errors": "catalog:",
    "ajv-i18n": "catalog:",
    "ajv-keywords": "catalog:",
    "bits-ui": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "lodash": "^4.17.21",
    "maska": "catalog:",
    "paneforge": "catalog:",
    "playwright": "^1.58.1",
    "publint": "catalog:",
    "runed": "catalog:",
    "shadcn-svelte": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "svelte-toolbelt": "catalog:",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "sideEffects": true
}
