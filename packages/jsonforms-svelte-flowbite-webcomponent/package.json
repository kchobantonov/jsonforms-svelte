{
  "name": "@chobantonov/jsonforms-svelte-flowbite-webcomponent",
  "version": "1.0.2",
  "description": "Flowbite-based JSONForms Svelte Web Component",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-flowbite-webcomponent"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build",
    "preview": "vp preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "types"
  ],
  "types": "./types/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/jsonforms-svelte-flowbite.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-flowbite": "workspace:*",
    "@chobantonov/jsonforms-svelte-flowbite-extended": "workspace:*",
    "@jsonforms/core": "catalog:",
    "ag-grid-community": "^36.0.1",
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "ajv-i18n": "^4.2.0",
    "ajv-keywords": "^5.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.10.6",
    "flowbite-typography": "^1.0.5",
    "lodash": "^4.17.21",
    "tailwind-variants": "^3.2.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "^4.14.172",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "flowbite": "^4.0.1",
    "flowbite-svelte": "^1.33.1",
    "flowbite-svelte-icons": "^3.1.0",
    "globals": "^17.3.0",
    "playwright": "^1.58.1",
    "publint": "^0.3.17",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "catalog:",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  },
  "sideEffects": true
}
