{
  "name": "@chobantonov/jsonforms-svelte-flowbite-webcomponent",
  "version": "1.0.2",
  "description": "Flowbite-based JSONForms Svelte Web Component",
  "author": "Krasimir Chobantonov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-svelte.git",
    "directory": "packages/jsonforms-svelte-flowbite-webcomponent"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build",
    "preview": "vp preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test --run"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "types": "./dist/types/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/jsonforms-svelte-flowbite.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-flowbite": "workspace:*",
    "@chobantonov/jsonforms-svelte-flowbite-extended": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "ag-grid-community": "catalog:",
    "ajv": "catalog:",
    "ajv-errors": "catalog:",
    "ajv-i18n": "catalog:",
    "ajv-keywords": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "flowbite": "catalog:",
    "flowbite-svelte": "catalog:",
    "flowbite-svelte-icons": "catalog:",
    "flowbite-typography": "^1.0.5",
    "lodash": "^4.17.21",
    "playwright": "^1.58.1",
    "publint": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "@chobantonov/jsonforms-svelte-renderer-common": "workspace:*"
  },
  "sideEffects": true
}
