{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kchobantonov.github.io/jsonforms-extended-spec/schemas/example.schema.json",
  "title": "Specification example catalog entry",
  "type": "object",
  "required": ["id", "title", "files", "hostRequirements"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*\\.json$"
      }
    },
    "hostRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
