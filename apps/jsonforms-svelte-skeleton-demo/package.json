{
  "name": "jsonforms-svelte-skeleton-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test run"
  },
  "dependencies": {
    "@chobantonov/jsonforms-svelte-demo-common": "workspace:*",
    "@chobantonov/jsonforms-svelte": "workspace:*",
