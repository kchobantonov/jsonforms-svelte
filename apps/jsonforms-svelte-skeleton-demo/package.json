{
  "name": "jsonforms-svelte-skeleton-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "npm run check && vp build",
    "preview": "vp preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "vp fmt --check . && vp lint . && eslint .",
    "format": "vp fmt .",
    "test": "vp test run"
  },
  "dependencies": {
    "@chobantonov/jsonforms-svelte-demo-common": "workspace:*",
    "@chobantonov/jsonforms-svelte": "workspace:*",
    "@chobantonov/jsonforms-svelte-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-skeleton": "workspace:*",
    "@chobantonov/jsonforms-svelte-skeleton-extended": "workspace:*",
    "@chobantonov/jsonforms-svelte-skeleton-webcomponent": "workspace:*",
    "@jsonforms/core": "catalog:",
    "@jsonforms/examples": "catalog:",
    "@lucide/svelte": "catalog:",
    "@skeletonlabs/skeleton": "catalog:",
    "@skeletonlabs/skeleton-svelte": "catalog:",
    "ajv": "catalog:",
    "ajv-keywords": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "lodash": "^4.17.21",
    "monaco-editor": "catalog:",
    "@chobantonov/jsonforms-svelte-renderer-common": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@tailwindcss/forms": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "^1.58.1",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-static-copy": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:",
    "vite-plus": "catalog:"
  }
}
